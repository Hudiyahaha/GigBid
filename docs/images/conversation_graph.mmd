config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	fetch_thread(fetch_thread)
	intent(intent)
	slots(slots)
	client_liaison(client_liaison)
	compliance(compliance)
	preview(preview)
	executor(executor)
	human_approval(human_approval)
	__end__([<p>__end__</p>]):::last
	__start__ --> fetch_thread;
	client_liaison --> compliance;
	compliance -.-> __end__;
	compliance -.-> preview;
	fetch_thread -.-> __end__;
	fetch_thread -.-> intent;
	human_approval -.-> __end__;
	human_approval -.-> compliance;
	human_approval -.-> executor;
	intent -.-> __end__;
	intent -.-> slots;
	preview --> human_approval;
	slots --> client_liaison;
	executor --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
