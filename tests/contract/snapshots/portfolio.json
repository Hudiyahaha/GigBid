                  },
                  "maxItems": 12,
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Optional list of individual requirements; decomposing variants retrieve once per requirement",
              "title": "Requirements"
            },
            "types": {
              "anyOf": [
                {
                  "items": {
                    "enum": [
                      "case_study",
                      "repo",
                      "review",
                      "cv",
                      "proposal"
                    ],
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Types"
            }
          },
          "title": "EvidenceFilters",
          "type": "object"
        }
      },
      "properties": {
        "filters": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceFilters"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "k": {
          "default": 5,
          "maximum": 20,
          "minimum": 1,
          "title": "K",
          "type": "integer"
        },
        "requirement": {
          "maxLength": 4000,
          "minLength": 2,
          "title": "Requirement",
          "type": "string"
        }
      },
      "required": [
        "requirement"
      ],
      "title": "search_evidenceArguments",
      "type": "object"
    },
    "output": {
      "$defs": {
        "EvidenceOut": {
          "properties": {
            "client_industry": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Client Industry"
            },
            "date": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Date"
            },
            "item_id": {
              "title": "Item Id",
              "type": "string"
            },
            "outcome": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Outcome"
            },
            "project": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Project"
            },
            "relevance": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Calibrated 0..1 cross-encoder relevance to the query",
              "title": "Relevance"
            },
            "score": {
              "default": 0.0,
              "title": "Score",
              "type": "number"
            },
            "skills": {
              "items": {
                "type": "string"
              },
              "title": "Skills",
              "type": "array"
            },
            "snippet": {
              "default": "",
              "title": "Snippet",
              "type": "string"
            },
            "source": {
              "default": "",
              "title": "Source",
              "type": "string"
            },
            "title": {
              "title": "Title",
              "type": "string"
            },
            "type": {
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "item_id",
            "type",
            "title"
          ],
          "title": "EvidenceOut",
          "type": "object"
        }
      },
      "properties": {
        "items": {
