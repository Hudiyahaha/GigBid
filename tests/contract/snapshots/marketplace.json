  "create_proposal_draft": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": false
    },
    "input": {
      "properties": {
        "approval_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Token"
        },
        "bid_amount": {
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Bid Amount",
          "type": "number"
        },
        "cover_letter": {
          "maxLength": 5000,
          "minLength": 50,
          "title": "Cover Letter",
          "type": "string"
        },
        "dry_run": {
          "default": false,
          "title": "Dry Run",
          "type": "boolean"
        },
        "idempotency_key": {
          "description": "Unique key per logical write; retries with the same key never repeat it",
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9:_\\-.]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "job_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Job Id",
          "type": "string"
        },
        "pay_type": {
          "enum": [
            "fixed",
            "hourly"
          ],
          "title": "Pay Type",
          "type": "string"
        },
        "screening_answers": {
          "default": [],
          "items": {
            "maxLength": 2000,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Screening Answers",
          "type": "array"
        }
      },
      "required": [
        "job_id",
        "cover_letter",
        "bid_amount",
        "pay_type",
        "idempotency_key"
      ],
      "title": "create_proposal_draftArguments",
      "type": "object"
    },
    "output": {
      "$defs": {
        "Preview": {
          "properties": {
            "connects_balance": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Connects Balance"
            },
            "connects_balance_after": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Connects Balance After"
            },
            "connects_cost": {
              "default": 0,
              "title": "Connects Cost",
              "type": "integer"
            },
            "operation": {
              "title": "Operation",
              "type": "string"
            },
            "payload": {
              "additionalProperties": true,
              "title": "Payload",
              "type": "object"
            },
            "policy_version": {
              "default": null,
              "title": "Policy Version"
            },
            "target": {
              "title": "Target",
              "type": "string"
            },
            "warnings": {
              "items": {
                "type": "string"
              },
              "title": "Warnings",
              "type": "array"
            }
          },
          "required": [
            "operation",
            "target",
            "payload"
          ],
          "title": "Preview",
          "type": "object"
        }
      },
      "properties": {
        "dry_run": {
          "title": "Dry Run",
          "type": "boolean"
        },
        "idempotent_replay": {
          "default": false,
          "title": "Idempotent Replay",
          "type": "boolean"
        },
        "preview": {
          "anyOf": [
            {
              "$ref": "#/$defs/Preview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "result": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        }
      },
      "required": [
        "dry_run"
      ],
      "title": "WriteResult",
      "type": "object"
    }
  },
