# Copy to .env and fill in. NEVER commit .env. Values below are placeholders only.

# --- app / security ---
APP_ENV=development
APP_SECRET_KEY=replace_me                 # JWT signing; any long random string
APPROVAL_SECRET=replace_me                # HMAC key for human-approval tokens
TOKEN_ENCRYPTION_KEY=                     # Fernet key for OAuth tokens (optional; derived from APP_SECRET_KEY if empty)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
REVIEWER_EMAIL=                           # preloaded reviewer login (set on the deployed host)
REVIEWER_PASSWORD=
REVIEWER_PERSONA=ai_ml

# --- storage ---
DATABASE_URL=postgresql+psycopg://gigbid:gigbid@localhost:5432/gigbid
GIGBID_LOCAL_SQLITE=1                     # 1 = use SQLite locally (no Postgres needed); compose sets 0
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=                               # empty = in-process vector store

# --- marketplace ---
MARKETPLACE_MODE=gigsim                   # gigsim | upwork_live
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_POLICY_VERSION=2
GIGSIM_ADMIN_TOKEN=gigsim-admin
MARKETPLACE_MCP_TOKEN=                    # bearer tokens for the MCP servers' HTTP endpoints (optional locally)
PORTFOLIO_MCP_TOKEN=
WORKSPACE_MCP_TOKEN=
MCP_MODE=inproc                           # inproc (local) | http (compose)

# --- models (open profile by default) ---
MODEL_PROFILE=open                        # open | open_alt | paid
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
GIGBID_FAKE_LLM=0                         # 1 = deterministic heuristics, no LLM calls (tests, CI)
EMBED_BACKEND=st                          # st (sentence-transformers) | fastembed (ONNX, low-RAM deploy)
RAG_VARIANT=                              # override agent/config.yaml rag.variant

# --- observability ---
PHOENIX_COLLECTOR_ENDPOINT=               # e.g. http://localhost:6006 to enable tracing
PHOENIX_UI_URL=
