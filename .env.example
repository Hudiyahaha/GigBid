# Copy to .env and fill in. NEVER commit .env. Values below are placeholders only.
# (Comments are on their own lines: docker compose env files do not reliably strip inline comments.)

# --- app / security ---
APP_ENV=development
# JWT signing key: any long random string
APP_SECRET_KEY=replace_me
# HMAC key for human-approval tokens
APPROVAL_SECRET=replace_me
# Fernet key for OAuth tokens (optional; derived from APP_SECRET_KEY when empty)
TOKEN_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
# Preloaded reviewer login (set these on the deployed host)
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
REVIEWER_PERSONA=ai_ml

# --- storage ---
DATABASE_URL=postgresql+psycopg://gigbid:gigbid@localhost:5432/gigbid
# 1 = use SQLite locally (no Postgres needed); docker compose sets 0
GIGBID_LOCAL_SQLITE=1
REDIS_URL=redis://localhost:6379/0
# empty = in-process vector store
QDRANT_URL=

# --- marketplace ---
# gigsim | upwork_live
MARKETPLACE_MODE=gigsim
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_POLICY_VERSION=2
GIGSIM_ADMIN_TOKEN=gigsim-admin
# Bearer tokens for the MCP servers' HTTP endpoints (optional locally)
MARKETPLACE_MCP_TOKEN=
PORTFOLIO_MCP_TOKEN=
WORKSPACE_MCP_TOKEN=
# inproc (local) | http (compose)
MCP_MODE=inproc

# --- models (open profile by default) ---
# open | open_alt | paid
MODEL_PROFILE=open
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
# 1 = deterministic heuristics, no LLM calls (tests, CI)
GIGBID_FAKE_LLM=0
# st (sentence-transformers) | fastembed (ONNX, low-RAM deploy)
EMBED_BACKEND=st
# Override agent/config.yaml rag.variant (empty = use config)
RAG_VARIANT=

# --- observability ---
# e.g. http://localhost:6006 to enable Phoenix tracing
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_UI_URL=
